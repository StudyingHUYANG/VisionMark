# Copy desired settings into server/.env. Never commit real credentials.
HOST=127.0.0.1
PORT=8080
DB_PATH=./database/app.db
# Set a random secret of at least 32 characters for production.
# JWT_SECRET=
# NODE_ENV=production
# QWEN_API_KEY=
# CORS_ORIGIN=chrome-extension://YOUR_EXTENSION_ID

# Optional: explicit Python executable for yt-dlp (no arguments).
# VISIONMARK_PYTHON=D:/bili/VisionMark/.venv/Scripts/python.exe
